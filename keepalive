name: Supabase keep-alive

# Pings the Supabase database every 3 days so the free-tier project
# never hits the 7-day inactivity pause.
on:
  schedule:
    - cron: "0 3 */3 * *"   # 03:00 UTC (10:00 Bangkok) every 3rd day
  workflow_dispatch:         # adds a "Run workflow" button for manual testing

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Query Supabase
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
        run: |
          status=$(curl -s -o response.txt -w "%{http_code}" \
            "$SUPABASE_URL/rest/v1/jc_ops_meta?select=*&limit=1" \
            -H "apikey: $SUPABASE_ANON_KEY" \
            -H "Authorization: Bearer $SUPABASE_ANON_KEY")
          echo "HTTP status: $status"
          cat response.txt
          if [ "$status" -ge 400 ]; then
            echo "Ping failed"
            exit 1
          fi
